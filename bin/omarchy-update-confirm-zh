#!/usr/bin/env bash

set -euo pipefail

gum style --border normal --padding "1 2" \
  "准备更新吗？" \
  "" \
  "• 更新开始后将无法中止！" \
  "• 请确保设备已连接电源或电池电量充足" \
  "" \
  "更新内容：https://github.com/basecamp/omarchy/releases/latest"

echo

if ! gum confirm "继续更新吗？" \
  --affirmative "是" \
  --negative "否" \
  --no-show-help; then
  echo "已取消更新"
  exit 1
fi
