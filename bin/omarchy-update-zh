#!/usr/bin/env bash

set -euo pipefail

LOCALIZER_BIN="$HOME/.local/share/omarchy-zh-cn/bin"
LOCALIZED_UPDATE="$LOCALIZER_BIN/omarchy-update"

[[ -x $LOCALIZED_UPDATE ]] || {
  echo "找不到已生成的 Omarchy 中文更新命令：$LOCALIZED_UPDATE" >&2
  echo "请先运行 omarchy-zh-sync，然后重试。" >&2
  exit 1
}

# The localized updater is regenerated from the currently installed Omarchy
# scripts. Its child helpers are resolved from the same private directory.
exec env PATH="$LOCALIZER_BIN:$PATH" "$LOCALIZED_UPDATE" "$@"
