  [["smiling", "smile", "pleased"], "微笑 笑臉"],
  [["frowning", "frown"], "皺眉 不開心"],
  [["person", "adult"], "人物 成人"],
  [["man"], "男人 男性"], [["woman"], "女人 女性"],
  [["boy"], "男孩"], [["girl"], "女孩"],
  [["older"], "老人 年長者"], [["beard"], "鬍鬚"],
  [["student"], "學生"], [["teacher"], "老師 教師"], [["judge"], "法官"],
  [["farmer"], "農民"], [["cook"], "廚師"], [["mechanic"], "技師 維修工"],
  [["factory worker"], "工人 工廠"], [["office worker"], "上班族 辦公室"],
  [["scientist"], "科學家"], [["technologist"], "程式設計師 技術人員"],
  [["singer"], "歌手"], [["artist"], "藝術家"], [["pilot"], "飛行員"],
  [["astronaut"], "太空人"], [["firefighter"], "消防員"],
  [["health worker"], "醫護人員"], [["mx claus"], "聖誕老人"],
  [["police", "cop"], "警察"], [["detective", "sleuth"], "偵探"],
  [["guard"], "衛兵"], [["construction worker"], "建築工人"],
  [["superhero"], "超級英雄"], [["supervillain"], "超級反派"],
  [["mage", "wizard"], "法師 巫師"], [["fairy"], "仙子"],
  [["vampire"], "吸血鬼"], [["merperson"], "人魚"], [["elf"], "精靈"],
