];

function stripJsonc(raw) {
  return String(raw || "").replace(/^\s*\/\/[^\n]*(\n|$)/gm, "").replace(/,(\s*[}\]])/g, "$1");
}

function readJson(file) {
  return JSON.parse(fs.readFileSync(file, "utf8"));
}

function writeAtomic(file, content, mode) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  const temporary = `${file}.zh-new-${process.pid}`;
  fs.writeFileSync(temporary, content, mode ? { mode } : undefined);
  if (mode) fs.chmodSync(temporary, mode);
  fs.renameSync(temporary, file);
}

function loadOverrides() {
  const dir = overrideCandidates.find(candidate => fs.existsSync(path.join(candidate, "shell.json")));
  if (!dir) throw new Error("找不到台灣用語覆蓋詞庫，請重新執行安裝器");
  const load = name => {
    const file = path.join(dir, `${name}.json`);
    return fs.existsSync(file) ? readJson(file) : {};
  };
  return { shell: load("shell"), menu: load("menu"), keybindings: load("keybindings") };
}

function requireOfficialI18n() {
  for (const file of ["en/shell.json", "zh-TW/shell.json", "zh-TW/menu.json", "zh-TW/keybindings.json"]) {
    if (!fs.existsSync(path.join(officialI18n, file))) {
      throw new Error(`找不到 Omarchy 內建翻譯 ${file}；本版需要 Omarchy 4.5 以上`);
    }
  }
  if (!fs.existsSync(path.join(omarchyPath, "shell/Commons/I18n.qml"))) {
    throw new Error("找不到 Omarchy Shell 的 I18n 元件；本版需要 Omarchy 4.5 以上");
  }
}

// The override table is consulted first, and only while the shell's language
// is zh-TW; anything it does not carry falls through to Omarchy's own lookup.
function overlayModuleSource(overrides) {
  return `.pragma library
// 由 omarchy-zh-tw-sync 產生。介面語言為 zh-TW 時，先查本表的台灣用語覆蓋，
// 查無再交給 Omarchy 內建的 I18n。請勿手動編輯，下次同步會覆寫。

var overrides = ${JSON.stringify(overrides, null, 2)}

function lookup(i18n, key) {
  if (!i18n || i18n.language !== "zh-TW") return undefined
  var value = overrides[key]
  if (value && typeof value === "object") value = value.other
  return typeof value === "string" && value.length > 0 ? value : undefined
}

function t(i18n, key, fallback) {
  var value = lookup(i18n, key)
  return value !== undefined ? value : i18n.t(key, fallback)
}

function tn(i18n, key, count, fallback) {
  var value = lookup(i18n, key)
  return value !== undefined ? value : i18n.tn(key, count, fallback)
}

function bindT(i18n) {
  return function(key, fallback) { return t(i18n, key, fallback) }
}

function bindTn(i18n) {
  return function(key, count, fallback) { return tn(i18n, key, count, fallback) }
}
`;
}

// Matches I18n.t / I18n.tn, bare or qualified (Commons.I18n.t), as a call or
// as a function reference handed to a JS model.
const i18nUse = /(?<![\w.$])((?:[A-Za-z_$][\w$]*\.)*I18n)\.(tn?)\b(\s*\()?/g;

function routeI18n(file, stage) {
  const before = fs.readFileSync(file, "utf8");
  if (file.endsWith(".js")) {
    const code = before.split("\n").filter(line => !/^\s*(\/\/|\*|\/\*)/.test(line)).join("\n");
    if (/\bI18n\.tn?\b/.test(code)) {
      throw new Error(`外掛結構已變化：${path.relative(stage, file)} 直接呼叫 I18n，無法套用覆蓋`);
    }
    return false;
  }

  let routed = false;
  let after = before.replace(i18nUse, (match, object, method, call) => {
    routed = true;
    if (call) return `ZhTwI18n.${method}(${object}, `;
    return `ZhTwI18n.${method === "t" ? "bindT" : "bindTn"}(${object})`;
  });
  if (!routed) return false;

  const lines = after.split("\n");
  let lastImport = -1;
  for (let index = 0; index < lines.length; index++) {
    const line = lines[index].trim();
    if (/^import\s/.test(line)) lastImport = index;
    else if (line && !line.startsWith("//") && !line.startsWith("pragma ")) break;
  }
  if (lastImport < 0) throw new Error(`外掛結構已變化：${path.relative(stage, file)} 沒有 import 區段`);
  let relative = path.relative(path.dirname(file), path.join(stage, "ZhTwI18n.js")).split(path.sep).join("/");
  if (!relative.startsWith(".")) relative = `./${relative}`;
  lines.splice(lastImport + 1, 0, `import "${relative}" as ZhTwI18n`);
  after = lines.join("\n");
  fs.writeFileSync(file, after);
  return true;
}

function walkFiles(dir, callback) {
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    const full = path.join(dir, entry.name);
    if (entry.isDirectory()) walkFiles(full, callback);
    else callback(full);
  }
}

function copyEntry(sourceDir, source, stage, target = source) {
  const src = path.join(sourceDir, source);
  const dst = path.join(stage, target);
  fs.mkdirSync(path.dirname(dst), { recursive: true });
  fs.cpSync(src, dst, { recursive: true, dereference: true });
}

function normalizedEmoji(value) {
  return String(value || "").replace(/️/g, "");
}

function fallbackEmojiKeywords(value) {
  const words = ` ${String(value || "").toLowerCase().replace(/[^a-z0-9]+/g, " ").trim()} `;
  const matches = [];
  for (const [terms, translation] of emojiKeywordFallbacks) {
    if (terms.some(term => words.includes(` ${term} `))) matches.push(translation);
  }
  return matches;
}

function localizeEmojiKeywords(stage) {
  const emojiFile = path.join(stage, "emojis.json");
  if (!fs.existsSync(emojiFile)) throw new Error("表情符號外掛缺少 emojis.json");

  const annotationCandidates = [
    path.join(home, ".local/share/fcitx5/rime/opencc/emoji.txt"),
    path.join(home, ".config/fcitx5/rime/opencc/emoji.txt"),
    "/usr/share/opencc/emoji.txt",
    "/usr/share/fcitx5/rime-data/opencc/emoji.txt"
  ];
  const annotationFile = annotationCandidates.find(candidate => fs.existsSync(candidate));
  if (!annotationFile) return;

  const items = readJson(emojiFile);
  const keywordsByEmoji = new Map(items.map(item => [normalizedEmoji(item.e), new Set()]));
  for (const line of fs.readFileSync(annotationFile, "utf8").split(/\r?\n/)) {
    const tab = line.indexOf("\t");
    if (tab < 1) continue;
    const keyword = line.slice(0, tab).trim();
    if (!/[㐀-鿿]/.test(keyword)) continue;
    for (const token of line.slice(tab + 1).trim().split(/\s+/)) {
      const matches = keywordsByEmoji.get(normalizedEmoji(token));
      if (matches) matches.add(keyword);
    }
  }

  for (const item of items) {
    const additions = [...(keywordsByEmoji.get(normalizedEmoji(item.e)) || [])];
    if (additions.length === 0 && !/[㐀-鿿]/.test(item.k)) {
      additions.push(...fallbackEmojiKeywords(item.k));
    }
    if (additions.length > 0) item.k = `${item.k} ${additions.join(" ")}`;
  }
  fs.writeFileSync(emojiFile, JSON.stringify(items) + "\n");
}

function managedClone(targetDir, sourceId) {
  let manifest = {};
  try {
    manifest = readJson(path.join(targetDir, "manifest.json"));
  } catch (_) {
    throw new Error(`現有外掛缺少有效清單，拒絕覆蓋：${targetDir}`);
  }
  const managed = manifest.omarchy?.zhTwManaged === true;
  const matchingClone = manifest.omarchy?.clonedFrom === sourceId;
  if (!managed && !(adoptExisting && matchingClone)) {
    throw new Error(`現有外掛不是 omarchy-zh-tw 管理的複製，拒絕覆蓋：${targetDir}`);
  }
}

function rebuildPlugin(catalogEntry, overlaySource) {
  const sourceId = catalogEntry.id;
  const suffix = sourceId.slice("omarchy.".length);
  const targetDir = path.join(pluginRoot, `${user}.${suffix}`);
  if (!targetDir.startsWith(pluginRoot + path.sep)) throw new Error(`不安全的外掛路徑：${targetDir}`);
  if (fs.existsSync(targetDir)) managedClone(targetDir, sourceId);

  const stage = fs.mkdtempSync(path.join(pluginRoot, ".zh-sync."));
  const manifestPath = catalogEntry.manifestPath;
  const sourceDir = catalogEntry.sourceDir;
  const sourceManifest = readJson(manifestPath);
  const sources = [];

  try {
    if (path.basename(manifestPath) === "manifest.json") {
      fs.cpSync(sourceDir, stage, { recursive: true, dereference: true });
    } else {
      fs.copyFileSync(manifestPath, path.join(stage, "manifest.json"));
      const copies = [
        ...Object.values(sourceManifest.entryPoints || {}).map(source => ({ source, target: source })),
        ...((sourceManifest.omarchy || {}).clonePaths || [])
      ];
      for (const item of copies) copyEntry(sourceDir, item.source, stage, item.target);

      // Match `omarchy plugin clone`: when a dependency is relocated, update
      // relative references in the copied text files to point at its new path.
      for (const item of copies) {
        if (item.source === item.target) continue;
        walkFiles(stage, file => {
          if (!/\.(qml|js|json|jsonc|sh|md|txt)$/.test(file)) return;
          const before = fs.readFileSync(file, "utf8");
          const after = before.split(item.source).join(item.target);
          if (after !== before) fs.writeFileSync(file, after);
        });
      }
    }

    const manifestFile = path.join(stage, "manifest.json");
    const manifest = readJson(manifestFile);
    manifest.id = `${user}.${suffix}`;
    manifest.name = sourceManifest.name || sourceId;
    if (manifest.barWidget) {
      manifest.barWidget.displayName = sourceManifest.barWidget?.displayName || manifest.name;
    }
    manifest.omarchy = { ...(manifest.omarchy || {}), clonedFrom: sourceId, zhTwManaged: true };
    delete manifest.omarchy.clonePaths;
    fs.writeFileSync(manifestFile, JSON.stringify(manifest, null, 2) + "\n");

    let routedFiles = 0;
    walkFiles(stage, file => {
      if (!/\.(qml|js)$/.test(file)) return;
      sources.push(fs.readFileSync(file, "utf8"));
      if (routeI18n(file, stage)) routedFiles++;
    });
    if (routedFiles === 0) throw new Error(`外掛結構已變化：${sourceId} 沒有使用 I18n`);
    fs.writeFileSync(path.join(stage, "ZhTwI18n.js"), overlaySource);

    if (sourceId === "omarchy.emojis") localizeEmojiKeywords(stage);

    const backup = `${targetDir}.zh-old-${process.pid}`;
    if (fs.existsSync(backup)) fs.rmSync(backup, { recursive: true, force: true });
    if (fs.existsSync(targetDir)) fs.renameSync(targetDir, backup);
    try {
      fs.renameSync(stage, targetDir);
      fs.rmSync(backup, { recursive: true, force: true });
    } catch (error) {
      if (!fs.existsSync(targetDir) && fs.existsSync(backup)) fs.renameSync(backup, targetDir);
      throw error;
    }
  } finally {
    if (fs.existsSync(stage)) fs.rmSync(stage, { recursive: true, force: true });
  }
  return sources.join("\n");
}

// Managed clones the current list no longer needs go back to the official
// plugin through Omarchy's own remover, which keeps a timestamped backup.
function retireClones() {
  if (!fs.existsSync(pluginRoot)) return [];
  const wanted = new Set(pluginIds);
  const retired = [];
  for (const entry of fs.readdirSync(pluginRoot, { withFileTypes: true })) {
    if (!entry.isDirectory() || entry.name.startsWith(".")) continue;
    let manifest;
    try { manifest = readJson(path.join(pluginRoot, entry.name, "manifest.json")); } catch (_) { continue; }
    if (manifest.omarchy?.zhTwManaged !== true || wanted.has(manifest.omarchy?.clonedFrom)) continue;
    try {
      execFileSync("omarchy", ["plugin", "remove", entry.name, "--yes"], { stdio: quiet ? "ignore" : "inherit" });
      retired.push(entry.name);
    } catch (_) {
      warn(`無法移除不再需要的外掛複製 ${entry.name}，請手動執行：omarchy plugin remove ${entry.name}`);
    }
  }
  return retired;
}

function syncPlugins(overrides) {
  const catalog = JSON.parse(execFileSync("omarchy-plugin-catalog", { encoding: "utf8" }));
  const byId = new Map(catalog.filter(item => item.firstParty).map(item => [item.id, item]));
  const overlaySource = overlayModuleSource(overrides.shell);
  let rebuilt = 0;
  let cloneSources = "";
  for (const id of pluginIds) {
    const entry = byId.get(id);
    if (!entry) {
      warn(`Omarchy 已沒有內建外掛 ${id}，略過`);
      continue;
    }
    const targetDir = path.join(pluginRoot, `${user}.${id.slice("omarchy.".length)}`);
    if (!fs.existsSync(targetDir)) {
      warn(`找不到外掛複製 ${user}.${id.slice("omarchy.".length)}，該外掛的台灣用語覆蓋未套用；重新執行 install.sh 可補上`);
      continue;
    }
    cloneSources += rebuildPlugin(entry, overlaySource);
    rebuilt++;
  }

  const english = readJson(path.join(officialI18n, "en/shell.json"));
  const stale = Object.keys(overrides.shell).filter(key => !(key in english));
  if (stale.length) warn(`Omarchy 已移除這些字串，覆蓋不再需要：${stale.join("、")}`);
  if (rebuilt === pluginIds.length) {
    const unused = Object.keys(overrides.shell).filter(key => key in english && !cloneSources.includes(`"${key}"`) && !cloneSources.includes(`'${key}'`));
    if (unused.length) warn(`這些覆蓋字串不在任何外掛複製中，不會生效：${unused.join("、")}`);
  }
  return rebuilt;
}

function sameValue(a, b) {
  return JSON.stringify(a) === JSON.stringify(b);
}

// The user extension wins over the catalog, so a label set here replaces
// Omarchy's zh-TW one. The menu normalizes every extension entry into a whole
// item, blanking whatever the entry leaves out, so an override carries the
// current default row in full. Only the fields written last time are taken
// back before the new ones go in, which leaves the user's own edits alone.
function syncMenu(overrides) {
  if (!fs.existsSync(menuDefault)) return;
  const defaults = JSON.parse(stripJsonc(fs.readFileSync(menuDefault, "utf8")));
  const managedFile = path.join(stateDir, "menu-managed.json");
  let managed = {};
  try { managed = readJson(managedFile); } catch (_) {}

  let extension = {};
  if (fs.existsSync(menuUser)) {
    const raw = fs.readFileSync(menuUser, "utf8");
    if (raw.startsWith(legacyMenuHeader)) {
      // 0.2 wrote the whole 4.0 menu here, actions included, which would
      // override the current defaults. Start again from the pre-install file.
      const stamp = new Date().toISOString().replace(/[-:]/g, "").replace(/\..*/, "");
      fs.copyFileSync(menuUser, `${menuUser}.omarchy-zh-tw-0.2-${stamp}.bak`);
      const original = path.join(stateDir, "original/omarchy-menu.jsonc");
      try { extension = fs.existsSync(original) ? JSON.parse(stripJsonc(fs.readFileSync(original, "utf8"))) : {}; } catch (_) { extension = {}; }
      managed = {};
    } else {
      try {
        extension = JSON.parse(stripJsonc(raw));
      } catch (_) {
        warn("無法解析 omarchy-menu.jsonc，選單覆蓋未更新");
        return;
      }
    }
  }

  for (const [id, fields] of Object.entries(managed)) {
    const entry = extension[id];
    if (!entry || typeof entry !== "object") continue;
    for (const [field, value] of Object.entries(fields)) {
      if (sameValue(entry[field], value)) delete entry[field];
    }
    if (Object.keys(entry).length === 0) delete extension[id];
  }

  const written = {};
  const apply = (id, fields) => {
    const entry = extension[id] || {};
    const applied = {};
    for (const [field, value] of Object.entries({ ...defaults[id], ...fields })) {
      if (entry[field] !== undefined) continue;
      entry[field] = value;
      applied[field] = value;
    }
    if (Object.keys(applied).length) {
      extension[id] = entry;
      written[id] = applied;
    }
  };

  for (const [id, translation] of Object.entries(overrides.menu)) {
    const item = defaults[id];
    if (!item) continue;
    const fields = {};
    if (translation.label && item.label) {
      fields.label = translation.label;
      // A catalog translation keeps the English label searchable; a user
      // retitle does not, so carry it over by hand.
      const terms = Array.isArray(item.searchTerms) ? item.searchTerms.slice() : [];
      if (!terms.includes(item.label)) terms.push(item.label);
      fields.searchTerms = terms;
    }
    if (translation.title && item.title) fields.title = translation.title;
    apply(id, fields);
  }
  if (defaults["learn.keybindings"]) apply("learn.keybindings", { action: keybindingsZh });

  writeAtomic(menuUser, menuHeader + "\n" + JSON.stringify(extension, null, 2) + "\n");
  writeAtomic(managedFile, JSON.stringify(written, null, 2) + "\n");
}

// The keybindings panel reads its catalog from one path; a private copy of the
// script reads the merged official + override catalog instead.
function syncKeybindings(overrides) {
  if (!fs.existsSync(keybindingsSource)) return;
  const official = readJson(path.join(officialI18n, "zh-TW/keybindings.json"));
  writeAtomic(keybindingsCatalog, JSON.stringify({ ...official, ...overrides.keybindings }, null, 2) + "\n");

  const catalogLine = "  catalog=$OMARCHY_PATH/default/i18n/$language/keybindings.json\n";
  const cacheLine = '    cat "$OMARCHY_PATH/default/i18n/$(omarchy-language 2>/dev/null)/keybindings.json" 2>/dev/null\n';
  let content = fs.readFileSync(keybindingsSource, "utf8");
  if (content.includes(catalogLine) && content.includes(cacheLine)) {
    content = content
      .replace(catalogLine, catalogLine +
        '  if [[ $language == zh-TW && -f "$HOME/.local/share/omarchy-zh-tw/i18n/keybindings.json" ]]; then\n' +
        '    catalog="$HOME/.local/share/omarchy-zh-tw/i18n/keybindings.json"\n' +
        "  fi\n")
      .replace(cacheLine, cacheLine +
        '    cat "$HOME/.local/share/omarchy-zh-tw/i18n/keybindings.json" 2>/dev/null\n');
  } else {
    warn("快捷鍵面板結構已變化，Super + K 暫時改用 Omarchy 內建面板");
    content = '#!/usr/bin/env bash\n# omarchy-zh-tw：上游結構變化，暫時直接使用內建快捷鍵面板。\nexec omarchy-menu-keybindings "$@"\n';
  }
  writeAtomic(keybindingsZh, content, 0o755);
}

function syncShellSettings() {
  const shellPath = path.join(home, ".config/omarchy/shell.json");
  if (!fs.existsSync(shellPath)) return;

  const shell = readJson(shellPath);
  for (const section of ["left", "center", "right"]) {
    for (const widget of shell.bar?.layout?.[section] || []) {
      if (widget.id === `${user}.weather` || widget.id === "omarchy.weather") widget.unit = "metric";
    }
  }
  writeAtomic(shellPath, JSON.stringify(shell, null, 2) + "\n");
}

requireOfficialI18n();
const overrides = loadOverrides();
fs.mkdirSync(pluginRoot, { recursive: true });
fs.mkdirSync(stateDir, { recursive: true });
const retired = retireClones();
const rebuilt = syncPlugins(overrides);
syncMenu(overrides);
syncKeybindings(overrides);
syncShellSettings();
fs.writeFileSync(path.join(stateDir, "last-sync"), new Date().toISOString() + "\n");

// Quickshell can retain imported JavaScript modules across a plugin rescan.
// Restart the shell so the override table is always current.
if (!noRestart) {
  try { execFileSync("omarchy", ["restart", "shell"], { stdio: quiet ? "ignore" : "inherit" }); } catch (_) {
    try { execFileSync("omarchy-shell", ["shell", "rescanPlugins"], { stdio: quiet ? "ignore" : "inherit" }); } catch (_) {}
  }
}

for (const message of warnings) console.error(`注意：${message}`);
if (!quiet) {
  const retiredText = retired.length ? `，移除 ${retired.length} 個不再需要的複製` : "";
  console.log(`已同步 ${rebuilt} 個外掛複製${retiredText}，以及 Omarchy 選單和快捷鍵面板的台灣用語覆蓋。`);
}
