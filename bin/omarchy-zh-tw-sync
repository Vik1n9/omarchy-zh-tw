#!/usr/bin/env node

// Layer Taiwan-usage overrides over Omarchy's own zh-TW translation. Omarchy
// 4.5 ships the catalogs; this rebuilds the few plugin clones whose strings
// need changing, routes their I18n calls through the override table, and
// keeps the menu and keybindings overrides current. System files are read-only.

const fs = require("fs");
const os = require("os");
const path = require("path");
const { execFileSync } = require("child_process");

const quiet = process.argv.includes("--quiet");
const noRestart = process.argv.includes("--no-restart");
const adoptExisting = process.argv.includes("--adopt-existing");
const home = os.homedir();
const user = process.env.USER || path.basename(home);
const omarchyPath = "/usr/share/omarchy";
const officialI18n = path.join(omarchyPath, "default/i18n");
const pluginRoot = path.join(home, ".config/omarchy/plugins");
const menuDefault = path.join(omarchyPath, "default/omarchy/omarchy-menu.jsonc");
const menuUser = path.join(home, ".config/omarchy/extensions/omarchy-menu.jsonc");
const stateDir = path.join(home, ".local/state/omarchy-zh-tw");
const dataDir = path.join(home, ".local/share/omarchy-zh-tw");
const keybindingsSource = path.join(omarchyPath, "bin/omarchy-menu-keybindings");
const keybindingsZh = path.join(home, ".local/bin/omarchy-menu-keybindings-zh-tw");
const keybindingsCatalog = path.join(dataDir, "i18n/keybindings.json");
const menuHeader = "// omarchy-zh-tw：以下台灣用語覆蓋由 omarchy-zh-tw-sync 維護；你自己新增的項目與標籤會保留。";
const legacyMenuHeader = "// Omarchy 4 繁體中文選單";
const overrideCandidates = [
  path.resolve(__dirname, "../i18n/zh-TW"),
  path.join(dataDir, "i18n/zh-TW")
];

// Only plugins that show a string the override catalog changes are cloned.
// Everything else stays on the official plugin and its zh-TW catalog.
const pluginIds = [
  "omarchy.notifications", "omarchy.elsewhen", "omarchy.indicators",
  "omarchy.network", "omarchy.wifiqr", "omarchy.bluetooth",
  "omarchy.clipboard", "omarchy.monitor", "omarchy.emojis"
];

const supportedArgs = new Set(["--quiet", "--no-restart", "--adopt-existing", "--help"]);
for (const arg of process.argv.slice(2)) {
  if (!supportedArgs.has(arg)) throw new Error(`未知引數：${arg}`);
}
if (process.argv.includes("--help")) {
  console.log(`用法：omarchy-zh-tw-sync [--quiet] [--no-restart] [--adopt-existing]

在 Omarchy 內建的 zh-TW 翻譯上疊加台灣用語覆蓋，並重建需要覆蓋的外掛複製。
  --quiet           僅在失敗時輸出
  --no-restart      同步後不重新啟動 Omarchy Shell
  --adopt-existing  接管同名且來源相符的現有外掛複製`);
  process.exit(0);
}

const warnings = [];
function warn(message) {
  warnings.push(message);
}

