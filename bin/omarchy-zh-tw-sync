function stripJsonc(raw) {
  return String(raw || "").replace(/^\s*\/\/[^\n]*(\n|$)/gm, "").replace(/,(\s*[}\]])/g, "$1");
}

function translated(value) { return zh[value] || schemaZh[value] || value; }

function awkString(value) {
  return String(value).replace(/\\/g, "\\\\").replace(/"/g, '\\"');
}

function keybindingLocalizerSource() {
  const assignments = Object.entries(keybindingZh)
    .map(([from, to]) => `    zh["${awkString(from)}"] = "${awkString(to)}"`)
    .join("\n");

  return `localize_binding_records() {
  awk -F '\\t' '
  BEGIN {
    OFS = "\\t"
${assignments}
  }
  function translated_action(action, number) {
    if (action in zh) return zh[action]

    number = action
    if (number ~ /^Bar panel [0-9]+$/) {
      sub(/^Bar panel /, "", number); return "狀態列面板 " number
    }
    if (number ~ /^Move window silently to workspace [0-9]+$/) {
      sub(/^Move window silently to workspace /, "", number); return "將視窗靜默移到工作區 " number
    }
    if (number ~ /^Move window to workspace [0-9]+$/) {
      sub(/^Move window to workspace /, "", number); return "將視窗移到工作區 " number
    }
    if (number ~ /^Switch to workspace [0-9]+$/) {
      sub(/^Switch to workspace /, "", number); return "切換到工作區 " number
    }
    if (number ~ /^Switch to group window [0-9]+$/) {
      sub(/^Switch to group window /, "", number); return "切換到分組視窗 " number
    }
    if (action == "Move window to group on bottom") return "將視窗移到下方分組"
    if (action == "Move window to group on left") return "將視窗移到左側分組"
    if (action == "Move window to group on right") return "將視窗移到右側分組"
    if (action == "Move window to group on top") return "將視窗移到上方分組"
    return action
  }
  {
    marker = " → "
    position = index($1, marker)
    if (position > 0) {
      combo = substr($1, 1, position + length(marker) - 1)
      action = substr($1, position + length(marker))
      $1 = combo translated_action(action)
    }
    print
  }'
}

`;
}

function replaceRequired(content, from, to, label) {
  if (!content.includes(from)) throw new Error(`快捷鍵指令碼結構已變化：${label}`);
  return content.replace(from, to);
}

function syncKeybindings() {
  if (!fs.existsSync(keybindingsSource)) return;

  let content = fs.readFileSync(keybindingsSource, "utf8");
  content = replaceRequired(
    content,
    "output_keybindings() {\n  output_binding_records | cut -f1\n}",
    keybindingLocalizerSource() + "output_keybindings() {\n  output_binding_records | localize_binding_records | cut -f1\n}",
    "輸出函式"
  );
  content = replaceRequired(
    content,
    "records=$(output_binding_records)\n  selection=$(cut -f1 <<<\"$records\" |",
    "records=$(output_binding_records | localize_binding_records)\n  selection=$(cut -f1 <<<\"$records\" |",
    "互動列表"
  );
  content = replaceRequired(
    content,
    "omarchy-menu-select 'Keybindings' -- --width 800 --height 500",
    "omarchy-menu-select '快捷鍵' -- --width 800 --height 500",
    "面板標題"
  );

  fs.mkdirSync(path.dirname(keybindingsZh), { recursive: true });
  const temporary = `${keybindingsZh}.new-${process.pid}`;
  fs.writeFileSync(temporary, content, { mode: 0o755 });
  fs.chmodSync(temporary, 0o755);
  fs.renameSync(temporary, keybindingsZh);
}

function translateText(content) {
  let result = content;
  for (const [from, to] of Object.entries(zh)) {
    const source = JSON.stringify(from);
    const target = JSON.stringify(to);
    result = result.split(source).join(target);
  }
  return result;
}

function syncUpdateScripts() {
  fs.mkdirSync(updateLocalizerDir, { recursive: true });
  for (const [scriptName, replacements] of Object.entries(updateScriptReplacements)) {
    const source = path.join(updateSourceDir, scriptName);
    if (!fs.existsSync(source)) throw new Error(`找不到 Omarchy 更新指令碼：${source}`);

    let content = fs.readFileSync(source, "utf8");
    for (const [from, to, label] of replacements) {
      if (!content.includes(from)) throw new Error(`更新指令碼結構已變化：${scriptName} / ${label}`);
      content = content.split(from).join(to);
    }

    const target = path.join(updateLocalizerDir, scriptName);
    const temporary = `${target}.new-${process.pid}`;
    fs.writeFileSync(temporary, content, { mode: 0o755 });
    fs.chmodSync(temporary, 0o755);
    fs.renameSync(temporary, target);
  }
}

function normalizedEmoji(value) {
  return String(value || "").replace(/\uFE0F/g, "");
}

function fallbackEmojiKeywords(value) {
  const words = ` ${String(value || "").toLowerCase().replace(/[^a-z0-9]+/g, " ").trim()} `;
  const matches = [];
  for (const [terms, translation] of emojiKeywordFallbacks) {
    if (terms.some(term => words.includes(` ${term} `))) matches.push(translation);
  }
  return matches;
}

function localizeEmojiKeywords(stage) {
  const emojiFile = path.join(stage, "emojis.json");
  if (!fs.existsSync(emojiFile)) throw new Error("表情外掛缺少 emojis.json");

  const annotationCandidates = [
    path.join(home, ".local/share/fcitx5/rime/opencc/emoji.txt"),
    path.join(home, ".config/fcitx5/rime/opencc/emoji.txt"),
    "/usr/share/opencc/emoji.txt",
    "/usr/share/fcitx5/rime-data/opencc/emoji.txt"
  ];
  const annotationFile = annotationCandidates.find(candidate => fs.existsSync(candidate));
  if (!annotationFile) return;

  const items = JSON.parse(fs.readFileSync(emojiFile, "utf8"));
  const keywordsByEmoji = new Map(items.map(item => [normalizedEmoji(item.e), new Set()]));
  for (const line of fs.readFileSync(annotationFile, "utf8").split(/\r?\n/)) {
    const tab = line.indexOf("\t");
    if (tab < 1) continue;
    const keyword = line.slice(0, tab).trim();
    if (!/[\u3400-\u9fff]/.test(keyword)) continue;
    for (const token of line.slice(tab + 1).trim().split(/\s+/)) {
      const matches = keywordsByEmoji.get(normalizedEmoji(token));
      if (matches) matches.add(keyword);
    }
  }

  for (const item of items) {
    const additions = [...(keywordsByEmoji.get(normalizedEmoji(item.e)) || [])];
    if (additions.length === 0 && !/[\u3400-\u9fff]/.test(item.k)) {
      additions.push(...fallbackEmojiKeywords(item.k));
    }
    if (additions.length > 0) item.k = `${item.k} ${additions.join(" ")}`;
  }
  fs.writeFileSync(emojiFile, JSON.stringify(items) + "\n");
}

function walkFiles(dir, callback) {
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    const full = path.join(dir, entry.name);
    if (entry.isDirectory()) walkFiles(full, callback);
    else callback(full);
  }
}

function copyEntry(sourceDir, source, stage, target = source) {
  const src = path.join(sourceDir, source);
  const dst = path.join(stage, target);
  fs.mkdirSync(path.dirname(dst), { recursive: true });
  fs.cpSync(src, dst, { recursive: true, dereference: true });
}

function applyAgentsOverlay(stage, targetDir) {
  if (!agentsOverlayDir) throw new Error("找不到 Agents 用量擴充套件檔案，請重新執行安裝器");

  for (const directory of ["bin", "assets"]) {
    const source = path.join(agentsOverlayDir, directory);
    if (!fs.existsSync(source)) throw new Error(`Agents 用量擴充套件不完整：${source}`);
    fs.cpSync(source, path.join(stage, directory), { recursive: true, dereference: true });
  }
  for (const script of ["codex", "codex-collector", "grok-collector", "kimi-collector", "usage-update"]) {
    fs.chmodSync(path.join(stage, "bin", script), 0o755);
  }

  const mainFile = path.join(stage, "Main.qml");
  const commandSource = '    var command = ["omarchy-agent-usage-update"]';
  let main = fs.readFileSync(mainFile, "utf8");
  if (!main.includes(commandSource)) throw new Error("Agents 外掛結構已變化：用量更新入口");
  main = main.replace(
    commandSource,
    `    var command = [${JSON.stringify(path.join(targetDir, "bin", "usage-update"))}]`
  );
  fs.writeFileSync(mainFile, main);

  const extraReadme = path.join(agentsOverlayDir, "README.md");
  if (fs.existsSync(extraReadme)) fs.copyFileSync(extraReadme, path.join(stage, "README.omarchy-zh-tw.md"));
}

function rebuildPlugin(catalogEntry) {
  const sourceId = catalogEntry.id;
  const suffix = sourceId.slice("omarchy.".length);
  const targetDir = path.join(pluginRoot, `${user}.${suffix}`);
  if (!targetDir.startsWith(pluginRoot + path.sep)) throw new Error(`不安全的外掛路徑：${targetDir}`);

  if (fs.existsSync(targetDir)) {
    let installedManifest = {};
    try {
      installedManifest = JSON.parse(fs.readFileSync(path.join(targetDir, "manifest.json"), "utf8"));
    } catch (_) {
      throw new Error(`現有外掛缺少有效清單，拒絕覆蓋：${targetDir}`);
    }
    const managed = installedManifest.omarchy?.zhTwManaged === true;
    const matchingClone = installedManifest.omarchy?.clonedFrom === sourceId;
    if (!managed && !(adoptExisting && matchingClone)) {
      throw new Error(`現有外掛不是 omarchy-zh-tw 管理的複製，拒絕覆蓋：${targetDir}`);
    }
  }

  const stage = fs.mkdtempSync(path.join(pluginRoot, ".zh-sync."));
  const manifestPath = catalogEntry.manifestPath;
  const sourceDir = catalogEntry.sourceDir;
  const sourceManifest = JSON.parse(fs.readFileSync(manifestPath, "utf8"));

  try {
    if (path.basename(manifestPath) === "manifest.json") {
      fs.cpSync(sourceDir, stage, { recursive: true, dereference: true });
    } else {
      fs.copyFileSync(manifestPath, path.join(stage, "manifest.json"));
      const copies = [
        ...Object.values(sourceManifest.entryPoints || {}).map(source => ({ source, target: source })),
        ...((sourceManifest.omarchy || {}).clonePaths || [])
      ];
      for (const item of copies) copyEntry(sourceDir, item.source, stage, item.target);

      // Match `omarchy plugin clone`: when a dependency is relocated, update
      // relative references in the copied text files to point at its new path.
      for (const item of copies) {
        if (item.source === item.target) continue;
        walkFiles(stage, file => {
          if (!/\.(qml|js|json|jsonc|sh|md|txt)$/.test(file)) return;
          const before = fs.readFileSync(file, "utf8");
          const after = before.split(item.source).join(item.target);
          if (after !== before) fs.writeFileSync(file, after);
        });
      }
    }

    if (sourceId === "omarchy.speedtest" || sourceId === "omarchy.disk-speedtest") {
      if (!fs.existsSync(speedTestOverlaySource)) throw new Error("找不到測速共用介面元件");
      fs.copyFileSync(speedTestOverlaySource, path.join(stage, "SpeedTestOverlay.qml"));
    }

    const manifestFile = path.join(stage, "manifest.json");
    const manifest = JSON.parse(fs.readFileSync(manifestFile, "utf8"));
    manifest.id = `${user}.${suffix}`;
    manifest.name = translated(sourceManifest.name || sourceId);
    manifest.description = translated(manifest.description || "");
    if (manifest.barWidget) {
      manifest.barWidget.displayName = translated(sourceManifest.barWidget?.displayName || sourceManifest.name || sourceId);
      manifest.barWidget.description = translated(manifest.barWidget.description || "");
      manifest.barWidget.category = translated(manifest.barWidget.category || "");
      for (const field of manifest.barWidget.schema || []) {
        for (const key of ["label", "description", "noSelectionText", "placeholderText", "emptyText"]) {
          if (typeof field[key] === "string") field[key] = translated(field[key]);
        }
        for (const option of field.options || []) {
          if (typeof option.label === "string") option.label = translated(option.label);
          if (typeof option.description === "string") option.description = translated(option.description);
        }
      }
    }
    if (sourceId === "omarchy.agents") {
      manifest.description = "在 Omarchy 面板中顯示 Claude Code、Codex、Fireworks、Grok 和 Kimi 的用量與限額";
      manifest.barWidget = manifest.barWidget || {};
      manifest.barWidget.defaults = manifest.barWidget.defaults || {};
      manifest.barWidget.defaults.providers = {
        ...(manifest.barWidget.defaults.providers || {}),
        grok: { enabled: true },
        kimi: { enabled: true }
      };
    }
    manifest.omarchy = { ...(manifest.omarchy || {}), clonedFrom: sourceId, zhTwManaged: true };
    delete manifest.omarchy.clonePaths;
    fs.writeFileSync(manifestFile, JSON.stringify(manifest, null, 2) + "\n");

    walkFiles(stage, file => {
      if (!/\.(qml|js|json|jsonc)$/.test(file)) return;
      const before = fs.readFileSync(file, "utf8");
      let after = translateText(before);
      if (sourceId === "omarchy.indicators" && path.basename(file) === "Reminder.qml") {
        after = after.replace(
          'tooltip = String(data.tooltip || "")',
          'tooltip = reminderCount === 0 ? "設定提醒" : `${reminderCount} 個提醒`'
        );
      }
      if (sourceId === "omarchy.indicators" && path.basename(file) === "Dictation.qml") {
        after = after.replace(
          "activeTooltipText: state",
          'activeTooltipText: state === "recording" ? "正在聽寫" : state === "transcribing" ? "正在轉錄" : state'
        );
      }
      if (sourceId === "omarchy.clock" && path.basename(file) === "BarWidget.qml") {
        after = after.replace(
          "return Qt.formatDateTime(date, activeFormat.replace(/ww/g, Model.isoWeekLiteral(date.getFullYear(), date.getMonth(), date.getDate())))",
          'return Qt.locale("zh_TW").toString(date, activeFormat.replace(/ww/g, Model.isoWeekLiteral(date.getFullYear(), date.getMonth(), date.getDate())))'
        );
      }
      if (sourceId === "omarchy.clock" && path.basename(file) === "Panel.qml") {
        after = after
          .split("Qt.locale().").join('Qt.locale("zh_TW").')
          .replace(
            'Qt.formatDate(root.today, "MMMM d")',
            'Qt.locale("zh_TW").toString(root.today, "M月d日")'
          )
          .replace(
            'Qt.formatDate(root.viewDate, "MMMM yyyy").toUpperCase()',
            'Qt.locale("zh_TW").toString(root.viewDate, "yyyy年M月")'
          );
      }
      if (sourceId === "omarchy.weather" && path.basename(file) === "Panel.qml") {
        after = after.replace(
          'return Model.dayName(dateString, function(date) { return Qt.formatDate(date, "dddd") })',
          'return Model.dayName(dateString, function(date) { return Qt.locale("zh_TW").toString(date, "dddd") })'
        );
      }
      if (sourceId === "omarchy.power" && path.basename(file) === "Panel.qml") {
        const profileLabelSource = 'text: String(modelData).charAt(0).toUpperCase() + String(modelData).slice(1)';
        const profileLabelTarget = 'text: ({ "power-saver": "節能", "balanced": "平衡", "performance": "效能" })[String(modelData)] || String(modelData)';
        if (!after.includes(profileLabelSource)) throw new Error("電源外掛結構已變化：模式標籤");
        after = after.replace(profileLabelSource, profileLabelTarget);
      }
      if (sourceId === "omarchy.system-update" && path.basename(file) === "SystemUpdate.qml") {
        const updateCommandSource = "omarchy-launch-floating-terminal-with-presentation omarchy-update";
        const updateCommandTarget = `omarchy-launch-floating-terminal-with-presentation ${updateZh}`;
        if (!after.includes(updateCommandSource)) throw new Error("系統更新外掛結構已變化：更新入口");
        after = after.replace(updateCommandSource, updateCommandTarget);
      }
      if (sourceId === "omarchy.menu" && path.basename(file) === "Menu.qml") {
        after = after
          .replace(
            'message: "Do you want to uninstall " + ((root.deleteTarget && root.deleteTarget.label) || "") + "?"',
            'message: "確定要卸載「" + ((root.deleteTarget && root.deleteTarget.label) || "") + "」嗎？"'
          )
          .replace(
            'confirmText: "卸載"',
            'confirmText: "卸載"\n          cancelText: "取消"'
          );
      }
      if (sourceId === "omarchy.clipboard" && path.basename(file) === "Clipboard.qml") {
        const confirmSource = 'confirmText: "刪除"';
        if (!after.includes(confirmSource)) throw new Error("剪貼簿外掛結構已變化：清空確認按鈕");
        after = after.replace(confirmSource, 'confirmText: "刪除"\n          cancelText: "取消"');
      }
      if (sourceId === "omarchy.wifiqr" && path.basename(file) === "Panel.qml") {
        const propertySource = 'readonly property bool showingQr: qrSize > 0 && !loading && error === ""';
        const errorSource = 'onStreamFinished: if (!root.expectedStop) root.error = String(text || "").trim()';
        if (!after.includes(propertySource) || !after.includes(errorSource)) {
          throw new Error("無線網路 QR Code 外掛結構已變化：錯誤提示");
        }
        after = after
          .replace(propertySource, propertySource + `

  function localizedCommandError(value) {
    var messages = {
      "No active Wi-Fi connection": "沒有正在使用的無線網路連線",
      "Could not read the Wi-Fi name": "無法讀取無線網路名稱",
      "Enterprise Wi-Fi cannot be shared with a password QR code": "企業無線網路無法透過密碼 QR Code 分享",
      "Could not read the Wi-Fi password": "無法讀取無線網路密碼",
      "Enterprise Wi-Fi has no shareable password": "企業無線網路沒有可分享的密碼",
      "This network has no password": "此無線網路沒有密碼"
    }
    var message = String(value || "").trim()
    return messages[message] || message
  }`)
          .replace(errorSource, 'onStreamFinished: if (!root.expectedStop) root.error = root.localizedCommandError(text)');
      }
      if (sourceId === "omarchy.speedtest" && path.basename(file) === "Panel.qml") {
        const functionSource = '  function open(payloadJson) {';
        const errorSource = 'root.stderrText = String(text || "").trim()';
        if (!after.includes(functionSource) || !after.includes(errorSource)) {
          throw new Error("網路測速外掛結構已變化：錯誤提示");
        }
        after = after
          .replace(functionSource, `  function localizedCommandError(value) {
    var messages = {
      "No active network interface": "沒有可用的網路介面",
      "curl is required": "網路測速需要 curl",
      "Failed to fetch speed test endpoints": "無法取得測速節點"
    }
    var message = String(value || "").trim()
    return messages[message] || message
  }

${functionSource}`)
          .replace(errorSource, "root.stderrText = root.localizedCommandError(text)");
      }
      if (sourceId === "omarchy.disk-speedtest" && path.basename(file) === "Panel.qml") {
        const functionSource = '  function open(payloadJson) {';
        const errorSource = 'root.stderrText = String(text || "").trim()';
        if (!after.includes(functionSource) || !after.includes(errorSource)) {
          throw new Error("磁碟測速外掛結構已變化：錯誤提示");
        }
        after = after
          .replace(functionSource, `  function localizedCommandError(value) {
    var message = String(value || "").trim()
    var match
    if ((match = message.match(/^Cannot find a disk behind (.+)$/))) return "無法找到 " + match[1] + " 所在的磁碟"
    if ((match = message.match(/^No I\\/O statistics for (.+)$/))) return "無法讀取 " + match[1] + " 的磁碟 I/O 統計資訊"
    if ((match = message.match(/^Need at least (.+) free on (.+)$/))) return match[2] + " 至少需要 " + match[1] + " 可用空間"
    if ((match = message.match(/^Disk (read|write) test failed before finishing$/))) return "磁碟" + (match[1] === "read" ? "讀取" : "寫入") + "測速未完成"
    if ((match = message.match(/^Direct disk I\\/O is not available on (.+)$/))) return match[1] + " 不支援直接磁碟 I/O"
    return message
  }

${functionSource}`)
          .replace(errorSource, "root.stderrText = root.localizedCommandError(text)");
      }
      if (sourceId === "omarchy.notifications" && path.basename(file) === "NotificationCard.qml") {
        after = after
          .replace(
            'import "../NotificationLogic.js" as NotificationLogic',
            'import "../NotificationLogic.js" as NotificationLogic\nimport "NotificationLocalization.js" as NotificationLocalization'
          )
          .replace(
            'readonly property bool hovered: hoverTracker.hovered',
            'readonly property bool hovered: hoverTracker.hovered\n  readonly property string localizedSummary: NotificationLocalization.translate(summary, app)\n  readonly property string localizedBody: NotificationLocalization.translate(body, app)'
          )
          .replace(
            'readonly property bool summaryStartsWithGlyph: NotificationLogic.summaryStartsWithGlyph(summary)',
            'readonly property bool summaryStartsWithGlyph: NotificationLogic.summaryStartsWithGlyph(localizedSummary)'
          )
          .replace(
            'readonly property string sanitizedBody: sanitizeBody(body)',
            'readonly property string sanitizedBody: sanitizeBody(localizedBody)'
          )
          .replace('visible: root.summary.length > 0', 'visible: root.localizedSummary.length > 0')
          .replace('text: root.summary', 'text: root.localizedSummary');
      }
      if (after !== before) fs.writeFileSync(file, after);
    });

    if (sourceId === "omarchy.notifications") {
      fs.writeFileSync(
        path.join(stage, "components", "NotificationLocalization.js"),
        notificationLocalizationSource
      );
    }
    if (sourceId === "omarchy.emojis") localizeEmojiKeywords(stage);
    if (sourceId === "omarchy.agents") applyAgentsOverlay(stage, targetDir);

    const backup = `${targetDir}.zh-old-${process.pid}`;
    if (fs.existsSync(backup)) fs.rmSync(backup, { recursive: true, force: true });
    if (fs.existsSync(targetDir)) fs.renameSync(targetDir, backup);
    try {
      fs.renameSync(stage, targetDir);
      fs.rmSync(backup, { recursive: true, force: true });
    } catch (error) {
      if (!fs.existsSync(targetDir) && fs.existsSync(backup)) fs.renameSync(backup, targetDir);
      throw error;
    }
  } finally {
    if (fs.existsSync(stage)) fs.rmSync(stage, { recursive: true, force: true });
  }
}

function syncMenu() {
  if (!fs.existsSync(menuDefault)) return;
  const defaults = JSON.parse(stripJsonc(fs.readFileSync(menuDefault, "utf8")));
  let existing = {};
  if (fs.existsSync(menuUser)) {
    try { existing = JSON.parse(stripJsonc(fs.readFileSync(menuUser, "utf8"))); } catch (_) {}
  }
  for (const [id, item] of Object.entries(defaults)) {
    const prior = existing[id] || {};
    const localized = menuZh[id] || {};
    const defaultLabel = item.label;
    const defaultTitle = item.title;
    if (prior.label && prior.label !== defaultLabel) item.label = prior.label;
    else if (defaultLabel) item.label = localized.label || translated(defaultLabel);
    if (prior.title && prior.title !== defaultTitle) item.title = prior.title;
    else if (defaultTitle) item.title = localized.title || translated(defaultTitle);
  }
  for (const [id, item] of Object.entries(existing)) {
    if (!(id in defaults)) defaults[id] = item;
  }
  if (defaults["learn.keybindings"]) defaults["learn.keybindings"].action = keybindingsZh;
  if (defaults["update.omarchy"]) {
    defaults["update.omarchy"].action = `omarchy-launch-floating-terminal-with-presentation ${updateZh}`;
  }
  const header = "// Omarchy 4 繁體中文選單：動作來自目前系統版本，文字由本地繁體化流程保留。\n";
  fs.mkdirSync(path.dirname(menuUser), { recursive: true });
  fs.writeFileSync(menuUser, header + JSON.stringify(defaults, null, 2) + "\n");
}

function syncShellSettings() {
  const shellPath = path.join(home, ".config/omarchy/shell.json");
  if (!fs.existsSync(shellPath)) return;

  const shell = JSON.parse(fs.readFileSync(shellPath, "utf8"));
  for (const section of ["left", "center", "right"]) {
    for (const widget of shell.bar?.layout?.[section] || []) {
      if (widget.id === `${user}.weather` || widget.id === "omarchy.weather") widget.unit = "metric";
    }
  }

  const temporary = `${shellPath}.zh-new-${process.pid}`;
  fs.writeFileSync(temporary, JSON.stringify(shell, null, 2) + "\n");
  fs.renameSync(temporary, shellPath);
}

fs.mkdirSync(pluginRoot, { recursive: true });
fs.mkdirSync(stateDir, { recursive: true });
syncUpdateScripts();
const catalog = JSON.parse(execFileSync("omarchy-plugin-catalog", { encoding: "utf8" }));
const byId = new Map(catalog.filter(item => item.firstParty).map(item => [item.id, item]));
for (const id of pluginIds) {
  const entry = byId.get(id);
  if (!entry) throw new Error(`找不到系統外掛：${id}`);
  rebuildPlugin(entry);
}
syncMenu();
syncKeybindings();
syncShellSettings();
fs.writeFileSync(path.join(stateDir, "last-sync"), new Date().toISOString() + "\n");

// Quickshell can retain imported JavaScript modules across a plugin rescan.
// Restart the shell so notification display translations are always current.
if (!noRestart) {
  try { execFileSync("omarchy", ["restart", "shell"], { stdio: quiet ? "ignore" : "inherit" }); } catch (_) {
    try { execFileSync("omarchy-shell", ["shell", "rescanPlugins"], { stdio: quiet ? "ignore" : "inherit" }); } catch (_) {}
  }
}
if (!quiet) console.log(`已同步 ${pluginIds.length} 個繁體中文外掛、Omarchy 選單、快捷鍵面板和更新流程。`);
